<UserControl x:Class="DotnetGuard.KeyBox.App.Views.EntryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
            Background="{StaticResource SurfaceBrush}" Padding="16" Width="300" VerticalAlignment="Top">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText" Grid.Row="0" Text="&gt; new entry" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <TextBlock Grid.Row="2" Text="Title"/>
            <TextBox x:Name="TitleBox" Grid.Row="3"/>

            <TextBlock Grid.Row="5" Text="Icon"/>
            <ComboBox x:Name="IconComboBox" Grid.Row="6" FontSize="16"/>

            <TextBlock Grid.Row="8" Text="Category"/>
            <TextBox x:Name="CategoryBox" Grid.Row="9"/>

            <TextBlock Grid.Row="11" Text="Username"/>
            <TextBox x:Name="EntryUsernameBox" Grid.Row="12"/>

            <TextBlock Grid.Row="14" Text="Password"/>
            <TextBox x:Name="PasswordBox" Grid.Row="15"/>

            <TextBlock Grid.Row="17" Text="URL"/>
            <TextBox x:Name="UrlBox" Grid.Row="18"/>

            <TextBlock Grid.Row="20" Text="Notes"/>
            <TextBox x:Name="NotesBox" Grid.Row="21" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock x:Name="ErrorText" Grid.Row="23" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="25" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="Save" Width="80" Height="30" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
