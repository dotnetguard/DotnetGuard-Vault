<Window x:Class="DotnetGuard.KeyBox.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DotnetGuard.KeyBox.Core.Models;assembly=DotnetGuard.KeyBox.Core"
        xmlns:local="clr-namespace:DotnetGuard.KeyBox.App.Views"
        Title="DotnetGuard KeyBox" Icon="/Assets/app.ico" Height="600" Width="1040"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewMouseMove="Window_ActivityDetected" PreviewMouseDown="Window_ActivityDetected"
        PreviewKeyDown="Window_ActivityDetected">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                Background="{StaticResource SurfaceBrush}">
            <TreeView x:Name="CategoryTree" Background="Transparent" BorderThickness="0"
                      SelectedItemChanged="CategoryTree_SelectedItemChanged">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:CategoryGroup}" ItemsSource="{Binding Entries}">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type models:VaultEntry}">
                        <TextBlock>
                            <Run Text="{Binding IconKey, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Title, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="&gt; dotnetguard keybox // vault" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>

            <DataGrid x:Name="EntriesGrid" Grid.Row="2" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      ClipboardCopyMode="None"
                      SelectionChanged="EntriesGrid_SelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseEnter" Handler="EntryRow_MouseEnter"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Icon" Binding="{Binding IconKey}" Width="60" FontSize="20"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="140"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding EntryUsername}" Width="140"/>
                    <DataGridTemplateColumn Header="URL" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Hyperlink Click="UrlHyperlink_Click" Tag="{Binding Url}">
                                        <Run Text="{Binding Url}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="4" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}" Padding="10" MinHeight="90">
                <StackPanel>
                    <TextBlock Text="Notes" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="NotesDetailText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="6" Orientation="Horizontal">
                <Button x:Name="AddButton" Content="Add" Width="90" Height="30" Margin="0,0,8,0" Click="AddButton_Click"/>
                <Button x:Name="EditButton" Content="Edit" Width="90" Height="30" Margin="0,0,8,0" Click="EditButton_Click"/>
                <Button x:Name="DeleteButton" Content="Delete" Width="90" Height="30" Margin="0,0,8,0" Click="DeleteButton_Click"/>
                <Button x:Name="CopyButton" Content="Copy password" Width="130" Height="30" Margin="0,0,8,0" Click="CopyButton_Click"/>
                <Button x:Name="ExportButton" Content="Export" Width="90" Height="30" Margin="0,0,8,0" Click="ExportButton_Click"/>
                <Button x:Name="ImportButton" Content="Import" Width="90" Height="30" Margin="0,0,8,0" Click="ImportButton_Click"/>
                <Button x:Name="LockButton" Content="Lock" Width="90" Height="30" Margin="0,0,8,0" Click="LockButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="ClipboardStatusText" Grid.Row="8" HorizontalAlignment="Right"
                       Foreground="{StaticResource AccentBrush}" FontSize="12" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
