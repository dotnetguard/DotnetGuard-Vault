<Window x:Class="DotnetGuard.KeyBox.App.Views.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entry" Icon="/Assets/app.ico" Width="380" SizeToContent="Height"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Title"/>
        <TextBox x:Name="TitleBox" Grid.Row="1"/>

        <TextBlock Grid.Row="3" Text="Icon"/>
        <ComboBox x:Name="IconComboBox" Grid.Row="4" FontSize="16"/>

        <TextBlock Grid.Row="6" Text="Category"/>
        <TextBox x:Name="CategoryBox" Grid.Row="7"/>

        <TextBlock Grid.Row="9" Text="Username"/>
        <TextBox x:Name="EntryUsernameBox" Grid.Row="10"/>

        <TextBlock Grid.Row="12" Text="Password"/>
        <TextBox x:Name="PasswordBox" Grid.Row="13"/>

        <TextBlock Grid.Row="15" Text="URL"/>
        <TextBox x:Name="UrlBox" Grid.Row="16"/>

        <TextBlock Grid.Row="18" Text="Notes"/>
        <TextBox x:Name="NotesBox" Grid.Row="19" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>

        <TextBlock x:Name="ErrorText" Grid.Row="21" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="23" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Save" Width="80" Height="30" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
